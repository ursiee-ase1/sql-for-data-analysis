# Display specific columns from orders table
SELECT id, account_id, occurred_at
FROM orders;

# Limit the number of rows being displayed
SELECT occurred_at, account_id, channel
FROM web_events
LIMIT 15;

# Select specific columns and limit rows(order by one column)
SELECT id, occurred_at, total_amt_usd
FROM orders
ORDER BY occurred_at
LIMIT 10;

# Select specific columns, order by two columns 
SELECT id, account_id, total_amt_usd
FROM orders
ORDER BY total_amt_usd DESC, account_id;